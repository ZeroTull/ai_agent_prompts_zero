{
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "LS",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(mvn compile *)",
      "Bash(mvn test)",
      "Bash(mvn build)",
      "Bash(npm -v)",
      "Skill(save-progress)",
      "Bash(gh pr *)",
      "Bash(cd *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "Bash(glab ci *)",
      "Bash(glab api *)",
      "Bash(glab mr *)",
      "Bash(glab pipeline *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git merge-base *)",
      "Bash(az boards work-item show *)",
      "Bash(az boards query *)",
      "Bash(az repos pr show *)",
      "Bash(az repos pr list *)",
      "Bash(az pipelines runs show *)",
      "Bash(az pipelines runs list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(glab issue view *)",
      "Bash(glab issue list *)",
      "Bash(jira issue view *)",
      "Bash(jira issue list *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/*-token.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.config/.jira/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.azure/**)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.gradle/gradle.properties)",
      "Read(**/.env.test)",
      "Read(**/.env.ci)",
      "Read(**/.env.qa)",
      "Read(**/.env.uat)",
      "Read(**/.env.stage)",
      "Read(**/.env.docker)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/secrets/**/*.yaml)",
      "Read(**/secrets/**/*.yml)",
      "Read(**/secrets/**/*.json)",
      "Read(**/secrets/**/*.properties)",
      "Read(**/secrets/**/*.env)",
      "Read(**/secrets/**/*.conf)",
      "Read(**/secrets/**/*.txt)",
      "Bash(rm -rf *)",
      "Bash(glab ci get *--with-variables*)",
      "Bash(git diff *--output*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\"",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-claude.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "theme": "dark-ansi",
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences explicitly approved for that data",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
